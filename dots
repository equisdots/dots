#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# equisdots · dots — meta installer and updater for the equisdots stack
#
# Manages the whole org desktop: palettes, theme-sync, davincix, shell,
# hyprland, the plugin stack and xturing. Repos are cloned under
# ~/.local/share/equisdots and their files are placed (or linked) into
# ~/.config and ~/.local/bin.
#
# Usage: dots <command>
#   setup      full install: system stack (sudo) + user payload, in one run
#   install    clone/update every repo and place it in your system
#   update     git pull every repo and re-apply
#   system     run the hyprland installer (packages, fonts, login, PAM, ...)
#   doctor     check dependencies, clones and installed paths
#   list       show repo status (present / missing / dirty)
#   plugins    install and manage plugins (add, remove, available, list,
#              enable/disable) from the equisdots plugin registry
#   uninstall  remove links and the updater timer (config files are kept)
#
# Remote bootstrap:
#   bash <(curl -fsSL https://raw.githubusercontent.com/equisdots/dots/main/dots) setup
# ═══════════════════════════════════════════════════════════════════════════
set -euo pipefail

# Original invocation (used to re-exec ourselves after a self-update) and the
# hash of the running file (guards against pulling a new dots mid-run: bash
# reads the script incrementally, so rewriting it while running is unsafe).
ORIG_ARGS=("$@")
SELF_PATH="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
self_hash() { sha256sum "$SELF_PATH" 2>/dev/null | cut -d' ' -f1; }
SELF_HASH="$(self_hash)"

ORG="equisdots"
BASE="${XDG_DATA_HOME:-$HOME/.local/share}/equisdots"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
HYPR="$CFG/hypr"
QS="$HYPR/scripts/quickshell"
BIN="$HOME/.local/bin"
REPOS=(dots palettes theme-sync davincix shell plugin-api plugin-sdk plugins nyx hyprland xturing login)
# Plugins that ship with the stack: deployed on every install/update through
# the registry convention (no toggle write; the manifest's defaultEnabled
# decides the state, so existing users keep the feature).
DEFAULT_PLUGINS=(screenshots timex rss-reader clipboard quicknotes file-search sysmon keybinds)
# Plugin hub (equisdots/plugins): the standard, the concentration folder and
# the install registry. Cloned like any other repo; a copy of its registry.json
# is what the shell's Plugins page reads to list available plugins.
HUB="$BASE/plugins"
REGISTRY="$HUB/registry.json"
# The plugin hub (standard, registry, plugin sources) tracks `main`. If the
# local plugins checkout is still on the pre-merge `branch/experimental`, follow
# it automatically so an in-progress experimental install keeps working; an
# explicit override always wins:
#   EQUISDOTS_PLUGIN_BRANCH=branch/experimental dots plugins add <id>
if [[ -n "${EQUISDOTS_PLUGIN_BRANCH:-}" ]]; then
    PLUGIN_BRANCH="$EQUISDOTS_PLUGIN_BRANCH"
else
    _plugins_head="$(git -C "$BASE/plugins" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
    if [[ "$_plugins_head" == "branch/experimental" ]]; then
        PLUGIN_BRANCH="branch/experimental"
    else
        PLUGIN_BRANCH="main"
    fi
fi

msg()  { printf '\033[1;34m::\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m ✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m !\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m error:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
equisdots · dots — meta installer and updater for the equisdots stack

Usage: dots <command>
  setup      full install: system stack (sudo) + user payload, in one run
  install    clone/update every repo and place it in your system
  update     git pull every repo, re-apply and keep xwww at the pinned release
  reset      forced clean reinstall of the payload from origin/main (user data kept)
  system     run the hyprland installer (packages, fonts, login, PAM, xwww, ...)
  doctor     check dependencies, clones and installed paths
  list       show repo status (present / missing / dirty)
  plugins    add/remove/available/list + enable/disable (install registry)
  uninstall  remove links and the updater timer (config files are kept)

Remote bootstrap:
  bash <(curl -fsSL https://raw.githubusercontent.com/equisdots/dots/main/dots) setup
EOF
}

fetch_repo() {
    local name="$1" src="${2:-}" branch="${3:-main}" url
    [[ -n "$src" ]] || src="$ORG/$name"
    url="https://github.com/$src.git"
    if [[ -d "$BASE/$name/.git" ]]; then
        if [[ -n "$(git -C "$BASE/$name" status --porcelain 2>/dev/null)" ]]; then
            warn "$name: local changes; keeping the checkout (its payload will not be deployed)"
        # Managed clones are read-only: fetch + hard reset also recovers from
        # upstream force-pushes, where `pull --ff-only` would fail forever.
        elif git -C "$BASE/$name" fetch --depth 1 origin "$branch" --quiet 2>/dev/null \
             && git -C "$BASE/$name" reset --hard FETCH_HEAD --quiet; then
            ok "$name updated"
        else
            warn "$name: fetch failed (network?); using the existing checkout"
        fi
    else
        mkdir -p "$BASE"
        # Existing non-git copy (manual install): park it instead of failing.
        if [[ -d "$BASE/$name" && ! -d "$BASE/$name/.git" ]]; then
            mv "$BASE/$name" "$BASE/$name.pre-dots" && ok "$name: old copy -> $name.pre-dots"
        fi
        if git clone --depth 1 --branch "$branch" --recurse-submodules "$url" "$BASE/$name" --quiet; then
            ok "$name cloned"
        else
            warn "$name: clone failed (network? git missing?)"
            return 1
        fi
    fi
    # A repo may ship git submodules. Keep them in sync with the checkout so
    # the payload is complete before sync_repo rsyncs it into the live config.
    if [[ -f "$BASE/$name/.gitmodules" ]]; then
        if git -C "$BASE/$name" submodule sync --recursive >/dev/null 2>&1 \
           && git -C "$BASE/$name" submodule update --init --recursive --quiet 2>/dev/null; then
            ok "$name submodules"
        else
            warn "$name: submodule update failed (network?)"
        fi
    fi
}

sync_repo() {
    local name="$1"
    if [[ ! -d "$BASE/$name" ]]; then
        warn "$name: not cloned; skipping (retry: dots install)"
        return 0
    fi
    # Never deploy a clone with uncommitted changes: its payload can be older
    # than the live files (or mixed), and the rsync below would downgrade them.
    # fetch_repo already kept the checkout; keep the live system too.
    if [[ -d "$BASE/$name/.git" ]] \
       && [[ -n "$(git -C "$BASE/$name" status --porcelain 2>/dev/null)" ]]; then
        warn "$name: local changes; skipping its payload (live files kept)"
        warn "  reconcile: git -C $BASE/$name status  (commit, stash or park it)"
        return 0
    fi
    case "$name" in
        hyprland)
            msg "hyprland: config -> $HYPR"
            mkdir -p "$HYPR"
            rsync -a --exclude 'docs/' --exclude '.git*' "$BASE/hyprland/config/hypr/" "$HYPR/"
            # app configs shipped by this repo (rofi themes, dunst, cava)
            for c in rofi dunst cava; do
                if [[ -d "$BASE/hyprland/config/$c" ]]; then
                    mkdir -p "$CFG/$c"
                    rsync -a --exclude '.git*' "$BASE/hyprland/config/$c/" "$CFG/$c/"
                fi
            done
            # helper scripts live at the repo root (qs_manager, volume, lock...)
            mkdir -p "$HYPR/scripts"
            rsync -a --exclude '.git*' "$BASE/hyprland/scripts/" "$HYPR/scripts/"
            chmod +x "$HYPR/scripts"/*.sh 2>/dev/null || true
            # purge legacy artifacts from the pre-equisdots layout: anything
            # that no equisdots repo ships anymore must not stay behind.
            rm -rf "$HYPR/scripts/themesync"
            rm -f "$HYPR/scripts/theme-sync.sh" "$HYPR/scripts/sddm-colors.sh" \
                  "$HYPR/sddm-colors.sh" "$HYPR/sddm-colors.qml"
            # monthly dotfiles check (systemd --user timer, user-level)
            if [[ -x "$HYPR/scripts/dotfiles-update.sh" ]] && command -v systemctl >/dev/null 2>&1; then
                bash "$HYPR/scripts/dotfiles-update.sh" --install-timer >/dev/null 2>&1 || true
            fi
            # seed settings.json only when missing (never overwrite user config)
            if [[ ! -f "$HYPR/settings.json" && -f "$HYPR/default_settings.json" ]]; then
                cp "$HYPR/default_settings.json" "$HYPR/settings.json"
                ok "settings.json seeded from default_settings.json"
            fi
            # settings.json is ALWAYS default_settings.json + the user's values:
            #  1) migrate the pre-equisdots "dock" schema to the canonical "bar"
            #  2) drop legacy keys nothing reads anymore
            #  3) (re)apply the shipped defaults as the base (user values win;
            #     user arrays such as bar.zones are kept as-is)
            #  4) expand a leading "~" in wallpaperDir: the shipped default is
            #     "~/.config/hypr/wallpapers" and the shell resolves the path
            #     verbatim, so a literal tilde leaves the wallpaper picker empty
            #     and every apply fails with "File not found: ~/...".
            if [[ -f "$HYPR/settings.json" && -f "$HYPR/default_settings.json" ]] \
               && command -v jq >/dev/null 2>&1; then
                local tmp
                tmp="$(mktemp)"
                if jq --slurpfile def "$HYPR/default_settings.json" --arg home "$HOME" '
                    (if (has("dock") and (has("bar") | not)) then .bar = .dock else . end)
                    | del(.dock, .serpbar, .openGuideAtStartup, .topbarHelpIcon, .monitors)
                    | $def[0] * .
                    | (if ((.wallpaperDir // "") | startswith("~"))
                       then .wallpaperDir = ($home + (.wallpaperDir | ltrimstr("~"))) else . end)
                ' "$HYPR/settings.json" > "$tmp" 2>/dev/null; then
                    mv "$tmp" "$HYPR/settings.json"
                    ok "settings.json = defaults + user overrides"
                else
                    rm -f "$tmp"
                    warn "settings.json could not be migrated (left untouched)"
                fi
            fi ;;
        shell)
            msg "shell: quickshell -> $QS"
            mkdir -p "$QS"
            # --delete with dock/ excluded: the shell directory is fully managed
            # (legacy dock/topbar leftovers are purged) but the frozen palette
            # path (dock/palettes) survives untouched and rsync doesn't warn
            # trying to delete it.
            rsync -a --delete --exclude '.git*' --exclude 'docs/' --exclude 'dock/' --exclude 'ui/plugins/' \
                  --exclude 'core/sdk/' --exclude 'plugin-api.json' --exclude 'core/scripts/plugins_compat.sh' \
                  --exclude 'plugins-registry.json' --exclude 'plugin-*.qml' \
                  "$BASE/shell/" "$QS/"
            find "$QS" -name '*.sh' -exec chmod +x {} + 2>/dev/null || true
            # legacy pre-standard location (the old home of nyx's UI)
            rm -rf "$QS/ui/nyx" ;;
        plugin-api)
            # The normative contract + the compat evaluator (equisdots/plugin-api),
            # consumed by the shell scan and the hypr loader.
            if [[ ! -f "$BASE/plugin-api/plugin-api.json" ]]; then
                warn "plugin-api: payload missing in the clone (branch not merged?); skipping"
                return 0
            fi
            msg "plugin-api -> $QS (plugin-api.json + compat evaluator)"
            mkdir -p "$QS/core/scripts"
            cp -f "$BASE/plugin-api/plugin-api.json" "$QS/plugin-api.json"
            cp -f "$BASE/plugin-api/scripts/plugins_compat.sh" "$QS/core/scripts/plugins_compat.sh"
            chmod +x "$QS/core/scripts/plugins_compat.sh" 2>/dev/null || true ;;
        plugin-sdk)
            # The runtime QML kit (equisdots/plugin-sdk); the shell imports it
            # as `import "sdk"` from core/. Fingerprint: its api version must
            # match the deployed plugin-api.json.
            if [[ ! -d "$BASE/plugin-sdk/qml" ]]; then
                warn "plugin-sdk: payload missing in the clone (branch not merged?); skipping"
                return 0
            fi
            msg "plugin-sdk -> $QS/core/sdk (QML host kit)"
            mkdir -p "$QS/core/sdk"
            rsync -a --delete --exclude '.git*' "$BASE/plugin-sdk/qml/" "$QS/core/sdk/" ;;
        plugins)
            # The plugin hub (equisdots/plugins): the standard, the
            # concentration folder and the install registry. It has no payload
            # of its own; its registry copy feeds the shell's Plugins page
            # (Available to install) and the CLI listings.
            msg "plugins: registry -> $QS/plugins-registry.json"
            deploy_registry_copy ;;
        palettes)
            msg "palettes -> $QS/dock/palettes"
            mkdir -p "$QS/dock/palettes"
            # Flat set + index.json (the panel's card model, consumed by the
            # shell and editor) + the community/ subfolder, which the panel
            # and theme-sync resolve through the index "path" entries. cp -f
            # (no delete): user-created palettes and live editor edits
            # survive updates.
            cp -f "$BASE/palettes"/*.json "$QS/dock/palettes/" 2>/dev/null || true
            if [[ -d "$BASE/palettes/community" ]]; then
                mkdir -p "$QS/dock/palettes/community"
                cp -f "$BASE/palettes/community"/*.json "$QS/dock/palettes/community/" 2>/dev/null || true
            fi ;;
        theme-sync)
            mkdir -p "$BIN"
            cat > "$BIN/theme-sync" <<WRAP
#!/usr/bin/env bash
# equisdots · theme-sync wrapper (engine lives in its own repo)
exec "$BASE/theme-sync/theme-sync.sh" "\$@"
WRAP
            chmod +x "$BIN/theme-sync"
            ok "theme-sync -> $BIN/theme-sync" ;;
        davincix)
            mkdir -p "$BIN"
            cat > "$BIN/davincix" <<WRAP
#!/usr/bin/env bash
# equisdots · davincix wrapper (kernel lives in its own repo)
exec "$BASE/davincix/davincix.sh" "\$@"
WRAP
            chmod +x "$BIN/davincix"
            ok "davincix -> $BIN/davincix" ;;
        dots)
            mkdir -p "$BIN"
            cat > "$BIN/dots" <<WRAP
#!/usr/bin/env bash
# equisdots · dots wrapper (meta installer lives in its own repo)
exec "$BASE/dots/dots" "\$@"
WRAP
            chmod +x "$BIN/dots"
            ok "dots -> $BIN/dots" ;;
        login)
            msg "login: SDDM theme (installed system-wide by 'dots system')" ;;
        xturing)
            msg "xturing: terminal settings UI (rust build) -> $BIN/xturing"
            if ! command -v cargo >/dev/null 2>&1; then
                warn "xturing: cargo missing; skipping (run: dots system to install rust)"
            else
                # Build cache outside the managed clone: fetch_repo hard-resets
                # the checkout on every update and rebuilds stay incremental.
                local build_dir="${XDG_CACHE_HOME:-$HOME/.cache}/equisdots/xturing-build"
                mkdir -p "$BIN" "$build_dir"
                if CARGO_TARGET_DIR="$build_dir" cargo build --release --locked \
                     --manifest-path "$BASE/xturing/Cargo.toml" --quiet; then
                    install -m 0755 "$build_dir/release/xturing" "$BIN/xturing"
                    ok "xturing -> $BIN/xturing"
                else
                    warn "xturing: build failed (rust toolchain present?); skipping"
                fi
            fi ;;
        *)
            # A repo that is itself a plugin (plugin.json at its root, e.g.
            # nyx) deploys through the generic convention: the whole repo is
            # the UI face (shell tree) and the runtime subset (manifest,
            # hypr.lua, scripts/) goes to the registry. No per-plugin cases.
            if [[ -f "$BASE/$name/plugin.json" ]]; then
                deploy_plugin "$name" "$BASE/$name"
            fi ;;
    esac
}

cmd_install() {
    local c r n=0
    for c in git rsync; do
        if ! command -v "$c" >/dev/null 2>&1; then
            warn "dots install requires '$c' (run: dots system first)"
            return 1
        fi
    done
    for r in "${REPOS[@]}"; do
        # The plugin hub tracks the plugin-standard branch (experimental phase);
        # every other repo tracks main.
        if [[ "$r" == "plugins" ]]; then
            fetch_repo plugins "$ORG/plugins" "$PLUGIN_BRANCH" || true
        else
            fetch_repo "$r" || true
        fi
    done
    # If this very script was just updated, restart with the new version so the
    # old code never keeps running against a rewritten file.
    if [[ -n "$SELF_HASH" && "$(self_hash)" != "$SELF_HASH" ]]; then
        msg "dots was updated; restarting with the new version"
        exec "$SELF_PATH" "${ORIG_ARGS[@]}"
    fi
    for r in "${REPOS[@]}"; do sync_repo "$r"; done
    # Default plugins deploy through the same registry convention on every
    # install/update (screenshots moved out of hyprland + shell in the F2
    # cutover). No toggle is written: defaultEnabled keeps them on.
    local pid
    for pid in "${DEFAULT_PLUGINS[@]}"; do
        plugins_add "$pid" true false || warn "plugins: default plugin $pid could not be deployed"
    done
    for r in "${REPOS[@]}"; do [[ -d "$BASE/$r" ]] && n=$((n + 1)); done
    if [[ "$n" -eq 0 ]]; then
        warn "no repo could be cloned (network/git?); nothing was installed"
        return 1
    fi
    # Keep the version state (About / updater popup) aligned with the payload.
    if [[ -f "$BASE/hyprland/updates.json" ]] && command -v jq >/dev/null 2>&1; then
        local v
        v="$(jq -r '.version // empty' "$BASE/hyprland/updates.json" 2>/dev/null)"
        if [[ -n "$v" ]]; then
            mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}"
            printf 'LOCAL_VERSION="%s"\n' "$v" > "${XDG_STATE_HOME:-$HOME/.local/state}/equisdots-version"
        fi
    fi
    ok "installed ($n/${#REPOS[@]} repos) — restart the shell (qs kill; qs -p $QS/Shell.qml &)"
}

# ── xwww: keep the wallpaper binaries at the pinned release ─────────────────
# The pinned version is the default in scripts/install-xwww.sh (XWWW_VERSION
# overrides it). The hyprland installer only installs xwww when it is missing,
# so an existing older binary would survive `dots update`/`dots system`
# forever; this checks the running binary and reinstalls when it differs.

xwww_install_script() {
    local script
    for script in \
        "$(dirname "$SELF_PATH")/scripts/install-xwww.sh" \
        "$BASE/dots/scripts/install-xwww.sh"; do
        [[ -f "$script" ]] && { printf '%s\n' "$script"; return 0; }
    done
    return 1
}

xwww_wanted_version() {
    [[ -n "${XWWW_VERSION:-}" ]] && { printf '%s\n' "$XWWW_VERSION"; return 0; }
    local script
    script="$(xwww_install_script)" || return 1
    sed -n 's/^VERSION="${XWWW_VERSION:-\([^}]*\)}"$/\1/p' "$script" 2>/dev/null | head -1 || true
}

xwww_installed_version() {
    command -v xwww >/dev/null 2>&1 || return 0
    xwww --version 2>/dev/null | awk '{print $2}' | head -1 || true
}

cmd_xwww() {
    local script want have
    if ! script="$(xwww_install_script)"; then
        warn "xwww: scripts/install-xwww.sh not found; skipping"
        return 0
    fi
    want="$(xwww_wanted_version || true)"
    have="$(xwww_installed_version || true)"
    if [[ -n "$want" && "v${have}" == "$want" ]]; then
        ok "xwww $want"
        return 0
    fi
    msg "xwww ${have:-missing} -> ${want:-pinned} (sudo: /usr/local/bin)"
    if ! bash "$script"; then
        warn "xwww: install failed (network/sudo?); keeping ${have:-none}"
        return 1
    fi
}

cmd_update() { cmd_install; cmd_xwww; }

# ── reset: forced clean reinstall of the managed payload ─────────────────────
# `update` re-fetches the clones and copies over the live files; a half-written
# install, a file a repo no longer ships or a dirty managed clone (whose payload
# is skipped by design) can survive that. `reset` removes the deployed files and
# the managed clones first, then reinstalls everything from origin/main.
#
# User data is never touched: settings.json, config/ overrides, wallpapers/,
# the palette store (dock/palettes, including community + editor edits),
# display-config, idle-settings.json, README.md and the hyprland-backup-*
# snapshots survive. The system stack (sudo) is out of scope: run `dots system`.

reset_payload() {
    msg "reset: purging the deployed payload (user data is preserved)"

    # hypr scripts → managed, except the shell dir (holds the palette store).
    if [[ -d "$HYPR/scripts" ]]; then
        find "$HYPR/scripts" -mindepth 1 -maxdepth 1 ! -name quickshell \
            -exec rm -rf {} + 2>/dev/null || true
    fi

    # shell → $QS: drop everything except the palette store (dock/).
    if [[ -d "$QS" ]]; then
        find "$QS" -mindepth 1 -maxdepth 1 ! -name dock -exec rm -rf {} + 2>/dev/null || true
    fi

    # hyprland → $HYPR: repo-shipped files only (Lua modules, idle config and
    # the seeded defaults). settings.json, config/, wallpapers/,
    # display-config*, idle-settings.json and backups stay untouched.
    rm -f "$HYPR"/*.lua "$HYPR/hypridle.conf" "$HYPR/default_settings.json"

    # app configs shipped by hyprland (rofi themes, dunst, cava): remove exactly
    # the tracked files so an old copy cannot shadow the fresh one. Generated
    # files (colors.rasi template, cava config, kitty/nvim themes) are
    # re-created by the deploy + theme-sync below.
    if [[ -d "$BASE/hyprland/.git" ]]; then
        local rel app
        while IFS= read -r rel; do
            app="${rel#config/}"; app="${app%%/*}"
            rm -f "$CFG/$app/$(basename "$rel")"
        done < <(git -C "$BASE/hyprland" ls-files 'config/rofi' 'config/dunst' 'config/cava' 2>/dev/null)
    fi
}

reset_clones() {
    local r
    for r in "${REPOS[@]}"; do
        # Never delete the running dots checkout: bash reads this script
        # incrementally and rewriting it mid-run is unsafe. fetch_repo hard-
        # resets it anyway, so it still lands on the latest origin/main.
        [[ "$r" == "dots" ]] && continue
        if [[ -d "$BASE/$r" ]]; then
            rm -rf "$BASE/$r"
            ok "$r: clone dropped"
        fi
    done
}

cmd_reset() {
    case "${1:-}" in
        "") ;;
        *) die "reset: no options (usage: dots reset)" ;;
    esac
    reset_payload
    reset_clones
    cmd_install
    # Palette-derived files (rofi colors, cava, kitty, nvim, starship) are
    # regenerated so the desktop is consistent right after the reset.
    if [[ -x "$BASE/theme-sync/theme-sync.sh" ]]; then
        msg "reset: re-applying the active palette (theme-sync)"
        if bash "$BASE/theme-sync/theme-sync.sh" >/dev/null 2>&1; then
            ok "theme-sync re-applied"
        else
            warn "theme-sync failed; run 'theme-sync' manually after restarting the shell"
        fi
    fi
    msg "reset done — restart the shell (qs kill; qs -p $QS/Shell.qml &)"
}

# One-shot full install. Payload first (no sudo, always lands), system stack
# after. If git/rsync are missing the system stack runs first (it installs
# them) and the payload is retried afterwards. Failures are reported but never
# abort the other phase: a broken system step must not leave the desktop
# without the shell, palettes, engines or wrappers.
cmd_setup() {
    if command -v git >/dev/null 2>&1 && command -v rsync >/dev/null 2>&1; then
        cmd_install || warn "payload phase had errors (see above)"
        cmd_system "$@" || warn "system phase failed — payload is installed. Log: ls -t /tmp/hyprland-install-*.log | head -1; retry with: dots system"
    else
        warn "git/rsync missing: running the system stack first (installs them), then the payload"
        cmd_system "$@" || warn "system phase failed; trying the payload anyway"
        cmd_install || warn "payload phase had errors (see above)"
    fi
    ok "setup finished — log out and pick Hyprland at the login screen"
}

cmd_system() {
    msg "system stack: hyprland installer (packages, fonts, login theme, PAM, external configs)"
    fetch_repo hyprland || true
    if [[ ! -x "$BASE/hyprland/install.sh" ]]; then
        warn "hyprland/install.sh not found (clone failed?)"
        return 1
    fi
    # The guard tells install.sh that this run is under dots: the user payload
    # (shell, palettes, engines) is deployed by cmd_install right after.
    DOTS_SYSTEM_RUN=1 bash "$BASE/hyprland/install.sh" "$@"
    # install.sh only installs xwww when it is missing: align an existing
    # binary with the pinned release.
    cmd_xwww
}

cmd_list() {
    printf '%-12s %-10s %s\n' REPO STATE PATH
    for r in "${REPOS[@]}"; do
        local state="missing"
        [[ -d "$BASE/$r/.git" ]] && state=$(git -C "$BASE/$r" status --porcelain | wc -l | xargs -I{} sh -c '[[ {} -eq 0 ]] && echo clean || echo dirty')
        printf '%-12s %-10s %s\n' "$r" "$state" "$BASE/$r"
    done
}

cmd_doctor() {
    local fail=0
    # Required by autostart / keybinds / scripts.
    for c in git rsync hyprland qs jq curl python3 cava playerctl wl-paste cliphist \
             brightnessctl pamixer kitty rofi xwww-daemon mpvpaper; do
        if command -v "$c" >/dev/null 2>&1; then ok "$c"; else printf '\033[1;33m !\033[0m %s missing\n' "$c"; fail=1; fi
    done
    # Nice to have (their features degrade gracefully).
    for c in grim slurp satty hyprpicker blueman-applet nm-applet gsettings cargo; do
        if command -v "$c" >/dev/null 2>&1; then ok "$c"; else printf '\033[1;33m ~\033[0m %s optional, missing\n' "$c"; fi
    done
    if fc-match "Hack Nerd Font" 2>/dev/null | grep -qi "Hack Nerd Font"; then ok "Hack Nerd Font"; else printf '\033[1;33m !\033[0m Hack Nerd Font missing (glyphs will show as boxes)\n'; fail=1; fi
    local want_xwww have_xwww
    want_xwww="$(xwww_wanted_version || true)"
    have_xwww="$(xwww_installed_version || true)"
    if [[ -n "$want_xwww" && "v${have_xwww}" == "$want_xwww" ]]; then
        ok "xwww $want_xwww (wallpaper daemon)"
    else
        printf '\033[1;33m !\033[0m xwww %s != %s (run: dots update, or scripts/install-xwww.sh)\n' \
            "${have_xwww:-missing}" "${want_xwww:-unknown}"; fail=1
    fi

    # Repo clones (dots install).
    local r
    for r in "${REPOS[@]}"; do
        if [[ -d "$BASE/$r/.git" ]]; then ok "$r clone"; else printf '\033[1;33m !\033[0m %s clone missing (run: dots install)\n' "$r"; fail=1; fi
    done
    # Dirty managed clones are never deployed by `dots update` (their payload
    # could downgrade the live files); reconcile them so updates flow again.
    for r in "${REPOS[@]}"; do
        if [[ -d "$BASE/$r/.git" ]] && [[ -n "$(git -C "$BASE/$r" status --porcelain 2>/dev/null)" ]]; then
            printf '\033[1;33m !\033[0m %s clone has local changes: payload skipped (commit, stash or park the clone)\n' "$r"; fail=1
        fi
    done

    # Plugin identity integrity (local, no CI): registry duplicates, folder/
    # manifest mismatches and runtime collisions (report) are never silent.
    local rdups
    rdups="$(registry_dups)"
    if [[ -n "$rdups" ]]; then
        printf '\033[1;33m !\033[0m registry duplicate ids: %s\n' "$rdups"; fail=1
    else
        ok "registry ids unique"
    fi
    local dd did mism=0
    for root in "$HYPR/plugins" "$HYPR/plugins-user"; do
        [[ -d "$root" ]] || continue
        for dd in "$root"/*/; do
            [[ -f "${dd}plugin.json" ]] || continue
            did="$(jq -r '.id // empty' "${dd}plugin.json" 2>/dev/null || true)"
            if [[ -n "$did" && "$(basename "${dd%/}")" != "$did" ]]; then
                printf '\033[1;33m !\033[0m plugin folder/id mismatch: %s declares "%s"\n' "${dd%/}" "$did"
                fail=1; mism=1
            fi
        done
    done
    [[ "$mism" = 0 ]] && ok "installed plugin folders match their ids"
    local rpt="${XDG_CACHE_HOME:-$HOME/.cache}/equisdots/plugins-report.json"
    if [[ -f "$rpt" ]] && jq -e . "$rpt" >/dev/null 2>&1; then
        local ncoll
        ncoll="$(jq -r '[.[] | select(.status == "collision")] | length' "$rpt" 2>/dev/null || echo 0)"
        if [[ "${ncoll:-0}" -gt 0 ]]; then
            while IFS=$'\t' read -r cid cerr; do
                printf '\033[1;33m !\033[0m plugin id collision: %s (%s)\n' "$cid" "$cerr"
            done < <(jq -r '.[] | select(.status == "collision") | [.id, .error] | @tsv' "$rpt" 2>/dev/null)
            fail=1
        else
            ok "plugin ids unique (runtime report)"
        fi
    fi

    # Installed payload (dots install).
    local np nc
    np="$(ls "$QS/dock/palettes"/*.json 2>/dev/null | wc -l)"
    nc="$(ls "$QS/dock/palettes/community"/*.json 2>/dev/null | wc -l)"
    if [[ "$np" -gt 0 && "$nc" -gt 0 && -f "$QS/dock/palettes/index.json" ]]; then
        ok "palettes ($np flat + $nc community in $QS/dock/palettes)"
    else
        printf '\033[1;33m !\033[0m palettes incomplete in %s: flat=%s community=%s index.json=%s (run: dots install)\n' \
            "$QS/dock/palettes" "$np" "$nc" "$([[ -f "$QS/dock/palettes/index.json" ]] && echo yes || echo no)"
        fail=1
    fi
    for p in "$HYPR/hyprland.lua" "$QS/Shell.qml" "$QS/Lock.qml" "$QS/plugins-registry.json" "$QS/ui/plugins/timex/ui/TimexPopup.qml" "$QS/ui/plugins/timex/bar/Weather.qml" "$QS/ui/plugins/rss-reader/ui/RssReader.qml" "$QS/ui/plugins/clipboard/ui/ClipboardManager.qml" "$QS/ui/plugins/quicknotes/ui/QuickNotes.qml" "$QS/ui/plugins/file-search/ui/FileSearch.qml" "$QS/ui/plugins/screenshots/bar/Recording.qml" "$QS/ui/plugins/sysmon/bar/Sysmon.qml" "$QS/ui/plugins/nyx/front/MascotsOverlay.qml" "$HYPR/settings.json" "$HYPR/scripts/lock.sh" "$HYPR/hypridle.conf" "$BIN/davincix" "$BIN/theme-sync" "$BIN/dots" "$BIN/xturing"; do
        [[ -e "$p" ]] && ok "$p" || printf '\033[1;33m !\033[0m %s missing (run: dots install)\n' "$p"
    done

    # Version gates: the config is Lua (Hyprland 0.55+) and the wrappers live
    # in ~/.local/bin, which has to be reachable.
    if command -v hyprland >/dev/null 2>&1; then
        local hv
        hv="$(hyprland --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+' | head -1)"
        if [[ -n "$hv" ]] && awk -v v="$hv" 'BEGIN { exit !(v + 0 >= 0.55) }'; then
            ok "hyprland $hv (Lua config)"
        else
            printf '\033[1;33m !\033[0m hyprland < 0.55: config/hyprland.lua needs Lua support (update hyprland)\n'; fail=1
        fi
    fi
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ok "$HOME/.local/bin in PATH" ;;
        *) printf '\033[1;33m !\033[0m %s not in PATH (dots/theme-sync/davincix unreachable; run: dots system)\n' "$HOME/.local/bin"; fail=1 ;;
    esac

    # System pieces: lock PAM service and the static login (SDDM) theme.
    if [[ -f /etc/pam.d/quickshell ]] && grep -q "system-auth" /etc/pam.d/quickshell 2>/dev/null; then
        ok "/etc/pam.d/quickshell (lock screen PAM)"
    else
        printf '\033[1;33m !\033[0m /etc/pam.d/quickshell missing system-auth (run: dots system)\n'; fail=1
    fi
    if [[ -f /etc/sddm.conf.d/10-x-theme.conf ]]; then ok "/etc/sddm.conf.d/10-x-theme.conf"; else printf '\033[1;33m !\033[0m /etc/sddm.conf.d/10-x-theme.conf missing (run: dots system)\n'; fail=1; fi
    if [[ -f /usr/share/sddm/themes/x/Main.qml && ! -e /usr/share/sddm/themes/x/Colors.qml ]]; then
        ok "login theme 'x' (static)"
    elif [[ -f /usr/share/sddm/themes/x/Main.qml ]]; then
        printf '\033[1;33m !\033[0m old palette-synced SDDM theme installed (run: dots system)\n'; fail=1
    else
        printf '\033[1;33m !\033[0m /usr/share/sddm/themes/x missing (run: dots system)\n'; fail=1
    fi
    # The theme only shows if SDDM is the active display manager.
    local dm_name
    dm_name="$(basename "$(readlink /etc/systemd/system/display-manager.service 2>/dev/null)")"
    if [[ "$dm_name" == "sddm.service" ]]; then
        ok "display-manager -> sddm.service"
    else
        printf '\033[1;33m !\033[0m active display manager is %s, not SDDM: the login theme will not show (run: dots system)\n' "${dm_name:-none}"; fail=1
    fi

    # Monthly updater timer (dots install / install.sh).
    if systemctl --user is-active --quiet dotfiles-update.timer 2>/dev/null; then
        ok "dotfiles-update.timer active"
    else
        printf '\033[1;33m ~\033[0m dotfiles-update.timer not active (run: dots install)\n'
    fi
    local unit_exec
    unit_exec="$(systemctl --user show -p ExecStart --value dotfiles-update.service 2>/dev/null | grep -o '/[^ ;]*dotfiles-update\.sh' | head -1)"
    if [[ -n "$unit_exec" && "$unit_exec" != "$HYPR/scripts/dotfiles-update.sh" && "$unit_exec" != "$BASE/hyprland/scripts/dotfiles-update.sh" ]]; then
        printf '\033[1;33m ~\033[0m dotfiles-update.service points outside the install (%s); re-run: dots install\n' "$unit_exec"
    fi

    # Plugin compatibility (equisdots/plugin-api): fail if an ENABLED plugin is
    # incompatible with the deployed host API.
    if command -v jq >/dev/null 2>&1 && [[ -d "$HYPR/plugins" ]] && [[ -x "$QS/core/scripts/plugins_compat.sh" ]]; then
        local pid pname pstate pcomp pdot
        while IFS=$'\t' read -r pid pname _v _t pstate _d _tg pcomp; do
            [[ -n "$pid" && "$pcomp" == "incompat" ]] || continue
            if [[ "$pstate" == "enabled" ]]; then
                printf '\033[31m ✗\033[0m plugin %s is incompatible but enabled (dots plugins disable %s)\n' "$pid" "$pid"
                fail=1
            else
                printf '\033[1;33m ~\033[0m plugin %s is incompatible (disabled)\n' "$pid"
            fi
        done < <(plugins_scan 2>/dev/null | awk -F'\t' '!seen[$1]++')
    fi
    exit $fail
}

# ═══════════════════════════════════════════════════════════════════════════
# Plugins (equisdots plugin standard). Two sides:
#
#  - installed: folders with a plugin.json in $HYPR/plugins (managed by dots)
#    + $HYPR/plugins-user (user, wins on id). Enable state = the plugin's
#    toggle path in settings.json (plugin.json → "toggle", default
#    plugins.<id>.enabled).
#  - available: the install registry ($HUB/registry.json, equisdots/plugins)
#    lists every known plugin and where it comes from. `dots plugins add`
#    resolves a source (owner/repo + optional path), fetches it, deploys by
#    the standard convention and enables it. A copy of the registry is
#    deployed to $QS/plugins-registry.json so the shell's Plugins page can
#    list available plugins (the installed scan never reads it).
# ═══════════════════════════════════════════════════════════════════════════

# Clone/refresh the hub and make sure the registry is on disk (also refreshes
# the shell-visible copy).
ensure_hub() {
    if ! fetch_repo plugins "$ORG/plugins" "$PLUGIN_BRANCH"; then
        [[ -f "$REGISTRY" ]] || die "plugins: cannot fetch the registry ($ORG/plugins); check the network"
        warn "plugins: using the cached registry (fetch failed)"
    fi
    [[ -f "$REGISTRY" ]] || die "plugins: $REGISTRY not found in the hub clone"
    registry_validate
    deploy_registry_copy
}

# The shell's Plugins page reads this copy to list available plugins; the
# installed scan stays discovery-driven (folder scan).
deploy_registry_copy() {
    [[ -f "$REGISTRY" ]] || return 0
    mkdir -p "$QS"
    cp -f "$REGISTRY" "$QS/plugins-registry.json"
}

# One registry entry -> "source<TAB>path" (path empty for repo-root plugins).
registry_entry() { # <id>
    [[ -f "$REGISTRY" ]] || return 0
    jq -r --arg id "$1" '(.plugins // [])[] | select(.id == $id) | [.source, (.path // "")] | @tsv' \
        "$REGISTRY" 2>/dev/null | head -1
}

# Registry duplicate ids, comma-separated (empty = ok). Local integrity check;
# used by `plugins *` (fatal) and `doctor` (reported).
registry_dups() {
    [[ -f "$REGISTRY" ]] || return 0
    jq -r '(.plugins // []) | group_by(.id) | map(select(length > 1) | .[0].id) | join(", ")' \
        "$REGISTRY" 2>/dev/null || true
}

# The install index must be valid JSON with globally unique ids (no CI: this
# is the install-time gate).
registry_validate() {
    [[ -f "$REGISTRY" ]] || return 0
    jq -e . "$REGISTRY" >/dev/null 2>&1 || die "plugins: registry.json is not valid JSON ($REGISTRY)"
    local dups
    dups="$(registry_dups)"
    [[ -z "$dups" ]] || die "plugins: registry has duplicate ids: $dups"
}

# Best-effort Hyprland version (for compat evaluation; empty = unverifiable).
hyprland_version() {
    local v="" bin
    if command -v hyprctl >/dev/null 2>&1; then
        v="$(hyprctl version 2>/dev/null | grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+' | head -1 | tr -d 'v')"
    fi
    if [[ -z "$v" ]]; then
        for bin in Hyprland hyprland; do
            command -v "$bin" >/dev/null 2>&1 || continue
            v="$("$bin" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
            [[ -n "$v" ]] && break
        done
    fi
    printf '%s' "$v"
}

# Compatibility verdict for one manifest (ok|warn|incompat); fails open when
# the evaluator or the versions are unavailable (see equisdots/plugin-api).
plugin_compat() { # <plugin.json path>
    local f="$1" tool="$QS/core/scripts/plugins_compat.sh" c out
    local host_api="" shell_version=""
    [[ -f "$f" && -x "$tool" ]] || { printf 'ok'; return 0; }
    c="$(jq -c '.compat // empty' "$f" 2>/dev/null || true)"
    [[ -n "$c" ]] || { printf 'ok'; return 0; }
    if [[ -f "$QS/plugin-api.json" ]]; then
        host_api="$(jq -r '.api // empty' "$QS/plugin-api.json" 2>/dev/null || true)"
        shell_version="$(jq -r '.shell // empty' "$QS/plugin-api.json" 2>/dev/null || true)"
    fi
    out="$(HOST_API="$host_api" SHELL_VERSION="$shell_version" \
           HYPRLAND_VERSION="$(hyprland_version)" \
           bash "$tool" <<<"$c" 2>/dev/null || true)"
    printf '%s' "${out:-}" | jq -r '.state // "ok"' 2>/dev/null || printf 'ok'
}

# The plugin's effective settings toggle: manifest "toggle" or the default.
plugin_toggle_of() { # <plugin.json path> <id>
    local t=""
    if [[ -f "$1" ]]; then
        t="$(jq -r '.toggle // empty' "$1" 2>/dev/null || true)"
    fi
    [[ -n "$t" ]] || t="plugins.$2.enabled"
    printf '%s' "$t"
}

# Write one toggle atomically (the same jq setpath contract the shell uses).
plugin_write_toggle() { # <toggle path> <true|false>
    local toggle="$1" val="$2" path tmp
    [[ -f "$HYPR/settings.json" ]] || die "plugins: $HYPR/settings.json not found (run: dots install)"
    path="$(jq -nc --arg t "$toggle" '$t | split(".")')"
    tmp="$(mktemp "$HYPR/settings.json.tmp.XXXXXX")"
    if jq --argjson p "$path" --argjson v "$val" 'setpath($p; $v)' \
          "$HYPR/settings.json" > "$tmp" 2>/dev/null; then
        mv "$tmp" "$HYPR/settings.json"
    else
        rm -f "$tmp"
        die "plugins: could not write settings.json"
    fi
}

# Deploy by the standard convention (equisdots/plugins → docs/plugins.md §6):
#   whole plugin   -> the shell tree UI face  ($QS/ui/plugins/<id>)
#   runtime subset -> the registry            ($HYPR/plugins/<id>:
#                                               plugin.json, hypr.lua, scripts/)
deploy_plugin() { # <id> <source dir>
    local id="$1" src="$2"
    [[ -f "$src/plugin.json" ]] || die "plugins: no plugin.json in $src"
    # Id integrity (local, no CI): the fetched manifest must declare exactly
    # the requested id — a source can never be deployed under another identity.
    local srcid
    srcid="$(jq -r '.id // empty' "$src/plugin.json" 2>/dev/null || true)"
    [[ "$srcid" = "$id" ]] || die "plugin $id: source declares id '${srcid:-<missing>}' (refusing to deploy under the wrong identity)"
    msg "plugin $id: UI -> $QS/ui/plugins/$id"
    mkdir -p "$QS/ui/plugins/$id"
    rsync -a --delete --exclude '.git*' --exclude 'docs/' "$src/" "$QS/ui/plugins/$id/"
    mkdir -p "$HYPR/plugins/$id"
    cp -f "$src/plugin.json" "$HYPR/plugins/$id/"
    if [[ -f "$src/hypr.lua" ]]; then
        cp -f "$src/hypr.lua" "$HYPR/plugins/$id/"
    fi
    if [[ -d "$src/scripts" ]]; then
        msg "plugin $id: runtime -> $HYPR/plugins/$id (manifest + hypr.lua + scripts)"
        mkdir -p "$HYPR/plugins/$id/scripts"
        rsync -a --delete --exclude '.git*' "$src/scripts/" "$HYPR/plugins/$id/scripts/"
        find "$HYPR/plugins/$id/scripts" -name '*.sh' -exec chmod +x {} + 2>/dev/null || true
    fi
    # Plugin-owned settings: the plugin's settings live in ITS OWN file
    # ($HYPR/plugins/<id>/settings.json), never mixed into the core settings.json.
    # The manifest's "defaults" fragment is shipped here and seeds the plugin's
    # settings file ONCE (only when missing). The deploy never overwrites it, so
    # user values survive.
    local defs
    defs="$(jq -r '.defaults // empty' "$src/plugin.json" 2>/dev/null || true)"
    if [[ -n "$defs" && -f "$src/$defs" ]]; then
        cp -f "$src/$defs" "$HYPR/plugins/$id/defaults.json"
        if [[ ! -f "$HYPR/plugins/$id/settings.json" ]]; then
            cp -f "$src/$defs" "$HYPR/plugins/$id/settings.json"
            ok "plugin $id: settings.json seeded from $defs"
        fi
    fi
    # Standalone entries (manifest "standalone"): one root-level launcher per
    # entry. The launcher imports the entry's directory (relative to the shell
    # tree root) and instantiates it, so the entry runs with the shell tree as
    # the config root and may import the core kit. Stale launchers for this id
    # are removed first (idempotent redeploys).
    rm -f "$QS/plugin-$id-"*.qml 2>/dev/null || true
    local entry edir ebase rel
    while IFS= read -r entry; do
        [[ -n "$entry" ]] || continue
        edir="$(dirname "$entry")"
        [[ "$edir" == "." ]] && edir=""
        ebase="$(basename "$entry" .qml)"
        rel="ui/plugins/$id"
        [[ -n "$edir" ]] && rel="$rel/$edir"
        cat > "$QS/plugin-$id-$ebase.qml" <<LAUNCH
// generated by dots — standalone entry for plugin $id ($entry)
import "./$rel"

$ebase { }
LAUNCH
    done < <(jq -r '(.standalone // [])[]' "$src/plugin.json" 2>/dev/null)
}

plugins_settings() {
    local f="$HYPR/settings.json"
    if [[ -f "$f" ]] && jq -e . "$f" >/dev/null 2>&1; then jq -c . "$f"; else printf '{}'; fi
}

# TSV: id, name, version, type, state, dir, toggle, compat (user dir first: wins).
plugins_scan() {
    local sobj d e comp
    sobj="$(plugins_settings)"
    for d in "$HYPR/plugins-user" "$HYPR/plugins"; do
        [[ -d "$d" ]] || continue
        for e in "$d"/*/; do
            [[ -f "${e}plugin.json" ]] || continue
            comp="$(plugin_compat "${e}plugin.json")"
            jq -r --arg base "${e%/}" --argjson s "$sobj" --arg comp "$comp" '
                . as $m
                | select(($m.id // "") != "")
                | ($m.toggle // ("plugins." + $m.id + ".enabled")) as $t
                | ($t | split(".")) as $p
                | (try ($s | getpath($p)) catch null) as $v
                | [ $m.id, ($m.name // $m.id), ($m.version // "-"), ($m.type // "-"),
                    (if (if $v == null then ($m.defaultEnabled // false) else ($v == true) end)
                     then "enabled" else "disabled" end),
                    $base, $t, $comp ] | @tsv' "${e}plugin.json" 2>/dev/null || true
        done
    done
}

cmd_plugins() {
    command -v jq >/dev/null 2>&1 || die "plugins: jq is required"
    local sub="${1:-list}"
    case "$sub" in
        list|"")
            local rows
            rows="$(plugins_scan | awk -F'\t' '!seen[$1]++')"
            if [[ -z "$rows" ]]; then
                msg "no plugins installed ($HYPR/plugins, $HYPR/plugins-user)"
                return 0
            fi
            printf '\n  %-14s %-22s %-7s %-6s %-10s %s\n' "ID" "NAME" "VERSION" "TYPE" "STATE" "COMPAT"
            local id name ver type state _dir _toggle comp
            while IFS=$'\t' read -r id name ver type state _dir _toggle comp; do
                printf '  %-14s %-22s %-7s %-6s %-10s %s\n' "$id" "$name" "$ver" "$type" "$state" "${comp:-ok}"
            done <<< "$rows"
            printf '\n' ;;
        available)
            ensure_hub
            local installed id name source state
            installed=" $(plugins_scan | awk -F'\t' '!seen[$1]++ {printf "%s ", $1}')"
            printf '\n  %-14s %-24s %-30s %s\n' "ID" "NAME" "SOURCE" "STATE"
            while IFS=$'\t' read -r id name source; do
                state="available"
                case "$installed" in *" $id "*) state="installed" ;; esac
                printf '  %-14s %-24s %-30s %s\n' "$id" "$name" "$source" "$state"
            done < <(jq -r '(.plugins // [])[] | [.id, (.name // .id), .source] | @tsv' "$REGISTRY")
            printf '\n' ;;
        add)
            local id="${2:-}"
            [[ -n "$id" ]] || die "usage: dots plugins add <id> [--no-enable] [--force]"
            shift 2
            local no_enable=false force=false
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --no-enable) no_enable=true ;;
                    --force)     force=true ;;
                    *) die "plugins add: unknown option: $1 (usage: dots plugins add <id> [--no-enable] [--force])" ;;
                esac
                shift
            done
            plugins_add "$id" "$no_enable" "$force" ;;
        remove)
            plugins_remove "${2:-}" ;;
        enable|disable)
            local id="${2:-}" val=false row toggle comp="" force=false
            [[ -n "$id" ]] || die "usage: dots plugins enable|disable <id>"
            [[ "${3:-}" == "--force" ]] && force=true
            [[ "$sub" == "enable" ]] && val=true
            row="$(plugins_scan | awk -F'\t' -v id="$id" '$1 == id { print; exit }')"
            [[ -n "$row" ]] || die "plugins: unknown plugin: $id"
            toggle="$(cut -f7 <<< "$row")"
            comp="$(cut -f8 <<< "$row")"
            if [[ "$val" == "true" && "$comp" == "incompat" && "$force" != "true" ]]; then
                die "plugins: $id is incompatible with this host (re-run with --force to override)"
            fi
            plugin_write_toggle "$toggle" "$val"
            if [[ "$val" == "true" ]]; then ok "plugin $id: enabled"; else ok "plugin $id: disabled"; fi
            if command -v hyprctl >/dev/null 2>&1; then
                hyprctl reload >/dev/null 2>&1 || true
            fi ;;
        *) die "plugins: unknown subcommand (list|available|add|remove|enable|disable)" ;;
    esac
}

# ── plugins add: resolve → fetch → deploy by convention → enable ────────────
plugins_add() { # <id> <no_enable true|false> <force true|false>
    local id="$1" no_enable="$2" force="$3"
    local entry source repo path srcdir comp toggle
    ensure_hub
    entry="$(registry_entry "$id" || true)"
    [[ -n "$entry" ]] || die "plugins: unknown plugin: $id (see: dots plugins available)"
    IFS=$'\t' read -r source path <<< "$entry"
    repo="${source#*/}"
    if [[ "$repo" == "$source" ]]; then
        die "plugins: invalid source '$source' for $id (expected owner/repo)"
    fi
    msg "plugin $id: source $source${path:+ (path: $path)}"
    fetch_repo "$repo" "$source" "$PLUGIN_BRANCH" || die "plugins: could not fetch $source"
    srcdir="$BASE/$repo${path:+/$path}"
    [[ -f "$srcdir/plugin.json" ]] || die "plugins: no plugin.json at $source${path:+ → $path}"
    comp="$(plugin_compat "$srcdir/plugin.json")"
    case "$comp" in
        incompat)
            if [[ "$force" == true ]]; then
                warn "plugin $id: incompatible with this host; installing anyway (--force)"
            else
                die "plugins: $id is incompatible with this host (re-run with --force to override)"
            fi ;;
        warn) warn "plugin $id: compatibility could not be fully verified" ;;
    esac
    deploy_plugin "$id" "$srcdir"
    if [[ "$no_enable" != true ]]; then
        toggle="$(plugin_toggle_of "$srcdir/plugin.json" "$id")"
        plugin_write_toggle "$toggle" true
        ok "plugin $id: enabled ($toggle = true)"
    fi
    if command -v hyprctl >/dev/null 2>&1; then hyprctl reload >/dev/null 2>&1 || true; fi
    ok "plugin $id installed"
}

# ── plugins remove: drop the managed copies, switch the toggle off ──────────
# settings.json keeps the keys (no user-data surgery); user plugins
# (plugins-user/) are not managed by dots.
plugins_remove() { # <id>
    local id="$1"
    [[ -n "$id" ]] || die "usage: dots plugins remove <id>"
    local base_dir="$HYPR/plugins/$id" ui_dir="$QS/ui/plugins/$id"
    local toggle="" found=false entry source repo
    if [[ -f "$base_dir/plugin.json" ]]; then
        toggle="$(plugin_toggle_of "$base_dir/plugin.json" "$id")"
    fi
    if [[ -e "$base_dir" ]]; then rm -rf "$base_dir"; ok "removed $base_dir"; found=true; fi
    if [[ -e "$ui_dir" ]]; then rm -rf "$ui_dir"; ok "removed $ui_dir"; found=true; fi
    if [[ "$found" != true ]]; then
        if [[ -e "$HYPR/plugins-user/$id" ]]; then
            die "plugins: $id is a user plugin ($HYPR/plugins-user/$id); dots does not manage it"
        fi
        die "plugins: $id is not installed"
    fi
    plugin_write_toggle "${toggle:-plugins.$id.enabled}" false
    ok "plugin $id: disabled (${toggle:-plugins.$id.enabled} = false)"
    entry="$(registry_entry "$id" || true)"
    if [[ -n "$entry" ]]; then
        source="${entry%%$'\t'*}"
        repo="${source#*/}"
        if [[ -f "$BASE/$repo/plugin.json" ]]; then
            warn "plugin $id: its source repo ships with the stack; 'dots install/update' will redeploy it"
        fi
    fi
    if command -v hyprctl >/dev/null 2>&1; then hyprctl reload >/dev/null 2>&1 || true; fi
}

cmd_uninstall() {
    msg "removing links and the updater timer; config files and clones are kept"
    if [[ -x "$HYPR/scripts/dotfiles-update.sh" ]]; then
        bash "$HYPR/scripts/dotfiles-update.sh" --uninstall-timer >/dev/null 2>&1 || true
    else
        systemctl --user disable --now dotfiles-update.timer >/dev/null 2>&1 || true
        rm -f "$CFG/systemd/user/dotfiles-update.timer" "$CFG/systemd/user/dotfiles-update.service"
        systemctl --user daemon-reload >/dev/null 2>&1 || true
    fi
    rm -f "$BIN/theme-sync" "$BIN/davincix" "$BIN/dots" "$BIN/xturing"
    ok "done (repos remain in $BASE)"
}

case "${1:-help}" in
    setup)     shift; cmd_setup "$@" ;;
    install)   cmd_install ;;
    update)    cmd_update ;;
    reset)     shift; cmd_reset "$@" ;;
    system)    shift; cmd_system "$@" ;;
    doctor)    cmd_doctor ;;
    list)      cmd_list ;;
    plugins)   shift; cmd_plugins "$@" ;;
    uninstall) cmd_uninstall ;;
    *) usage ;;
esac
