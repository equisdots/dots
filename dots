#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# equisdots · dots — meta installer and updater for the equisdots stack
#
# Manages the whole org desktop: palettes, theme-sync, davincix, shell,
# hyprland and timex. Repos are cloned under ~/.local/share/equisdots and
# their files are placed (or linked) into ~/.config and ~/.local/bin.
#
# Usage: dots <command>
#   setup      full install: system stack (sudo) + user payload, in one run
#   install    clone/update every repo and place it in your system
#   update     git pull every repo and re-apply
#   system     run the hyprland installer (packages, fonts, login, PAM, ...)
#   doctor     check dependencies, clones and installed paths
#   list       show repo status (present / missing / dirty)
#   uninstall  remove links and the updater timer (config files are kept)
#
# Remote bootstrap:
#   bash <(curl -fsSL https://raw.githubusercontent.com/equisdots/dots/main/dots) setup
# ═══════════════════════════════════════════════════════════════════════════
set -euo pipefail

# Original invocation (used to re-exec ourselves after a self-update) and the
# hash of the running file (guards against pulling a new dots mid-run: bash
# reads the script incrementally, so rewriting it while running is unsafe).
ORIG_ARGS=("$@")
SELF_PATH="$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")"
self_hash() { sha256sum "$SELF_PATH" 2>/dev/null | cut -d' ' -f1; }
SELF_HASH="$(self_hash)"

ORG="equisdots"
BASE="${XDG_DATA_HOME:-$HOME/.local/share}/equisdots"
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
HYPR="$CFG/hypr"
QS="$HYPR/scripts/quickshell"
BIN="$HOME/.local/bin"
REPOS=(dots palettes theme-sync davincix shell hyprland timex login)

msg()  { printf '\033[1;34m::\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m ✓\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m !\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m error:\033[0m %s\n' "$*" >&2; exit 1; }

usage() {
    cat <<'EOF'
equisdots · dots — meta installer and updater for the equisdots stack

Usage: dots <command>
  setup      full install: system stack (sudo) + user payload, in one run
  install    clone/update every repo and place it in your system
  update     git pull every repo and re-apply
  system     run the hyprland installer (packages, fonts, login, PAM, ...)
  doctor     check dependencies, clones and installed paths
  list       show repo status (present / missing / dirty)
  uninstall  remove links and the updater timer (config files are kept)

Remote bootstrap:
  bash <(curl -fsSL https://raw.githubusercontent.com/equisdots/dots/main/dots) setup
EOF
}

fetch_repo() {
    local name="$1"
    if [[ -d "$BASE/$name/.git" ]]; then
        if [[ -n "$(git -C "$BASE/$name" status --porcelain 2>/dev/null)" ]]; then
            warn "$name: local changes; keeping the existing checkout"
        # Managed clones are read-only: fetch + hard reset also recovers from
        # upstream force-pushes, where `pull --ff-only` would fail forever.
        elif git -C "$BASE/$name" fetch --depth 1 origin main --quiet 2>/dev/null \
             && git -C "$BASE/$name" reset --hard FETCH_HEAD --quiet; then
            ok "$name updated"
        else
            warn "$name: fetch failed (network?); using the existing checkout"
        fi
    else
        mkdir -p "$BASE"
        # Existing non-git copy (manual install): park it instead of failing.
        if [[ -d "$BASE/$name" && ! -d "$BASE/$name/.git" ]]; then
            mv "$BASE/$name" "$BASE/$name.pre-dots" && ok "$name: old copy -> $name.pre-dots"
        fi
        if git clone --depth 1 "https://github.com/$ORG/$name.git" "$BASE/$name" --quiet; then
            ok "$name cloned"
        else
            warn "$name: clone failed (network? git missing?)"
            return 1
        fi
    fi
}

sync_repo() {
    local name="$1"
    if [[ ! -d "$BASE/$name" ]]; then
        warn "$name: not cloned; skipping (retry: dots install)"
        return 0
    fi
    case "$name" in
        hyprland)
            msg "hyprland: config -> $HYPR"
            mkdir -p "$HYPR"
            rsync -a --exclude 'docs/' --exclude '.git*' "$BASE/hyprland/config/hypr/" "$HYPR/"
            # app configs shipped by this repo (rofi themes, dunst, cava)
            for c in rofi dunst cava; do
                if [[ -d "$BASE/hyprland/config/$c" ]]; then
                    mkdir -p "$CFG/$c"
                    rsync -a --exclude '.git*' "$BASE/hyprland/config/$c/" "$CFG/$c/"
                fi
            done
            # helper scripts live at the repo root (qs_manager, volume, lock...)
            mkdir -p "$HYPR/scripts"
            rsync -a --exclude '.git*' "$BASE/hyprland/scripts/" "$HYPR/scripts/"
            chmod +x "$HYPR/scripts"/*.sh 2>/dev/null || true
            # purge legacy artifacts from the pre-equisdots layout: anything
            # that no equisdots repo ships anymore must not stay behind.
            rm -rf "$HYPR/scripts/themesync"
            rm -f "$HYPR/scripts/theme-sync.sh" "$HYPR/scripts/sddm-colors.sh" \
                  "$HYPR/sddm-colors.sh" "$HYPR/sddm-colors.qml"
            # monthly dotfiles check (systemd --user timer, user-level)
            if [[ -x "$HYPR/scripts/dotfiles-update.sh" ]] && command -v systemctl >/dev/null 2>&1; then
                bash "$HYPR/scripts/dotfiles-update.sh" --install-timer >/dev/null 2>&1 || true
            fi
            # seed settings.json only when missing (never overwrite user config)
            if [[ ! -f "$HYPR/settings.json" && -f "$HYPR/default_settings.json" ]]; then
                cp "$HYPR/default_settings.json" "$HYPR/settings.json"
                ok "settings.json seeded from default_settings.json"
            fi
            # settings.json is ALWAYS default_settings.json + the user's values:
            #  1) migrate the pre-equisdots "dock" schema to the canonical "bar"
            #  2) drop legacy keys nothing reads anymore
            #  3) (re)apply the shipped defaults as the base (user values win;
            #     user arrays such as bar.zones are kept as-is)
            if [[ -f "$HYPR/settings.json" && -f "$HYPR/default_settings.json" ]] \
               && command -v jq >/dev/null 2>&1; then
                local tmp
                tmp="$(mktemp)"
                if jq --slurpfile def "$HYPR/default_settings.json" '
                    (if (has("dock") and (has("bar") | not)) then .bar = .dock else . end)
                    | del(.dock, .serpbar, .openGuideAtStartup, .topbarHelpIcon, .monitors)
                    | $def[0] * .
                ' "$HYPR/settings.json" > "$tmp" 2>/dev/null; then
                    mv "$tmp" "$HYPR/settings.json"
                    ok "settings.json = defaults + user overrides"
                else
                    rm -f "$tmp"
                    warn "settings.json could not be migrated (left untouched)"
                fi
            fi ;;
        shell)
            msg "shell: quickshell -> $QS"
            mkdir -p "$QS"
            # --delete with dock/ excluded: the shell directory is fully managed
            # (legacy dock/topbar leftovers are purged) but the frozen palette
            # path (dock/palettes) survives untouched and rsync doesn't warn
            # trying to delete it.
            rsync -a --delete --exclude '.git*' --exclude 'docs/' --exclude 'dock/' "$BASE/shell/" "$QS/"
            find "$QS" -name '*.sh' -exec chmod +x {} + 2>/dev/null || true ;;
        palettes)
            msg "palettes -> $QS/dock/palettes"
            mkdir -p "$QS/dock/palettes"
            # index.json belonged to the old shell; the palettes repo does not
            # ship it and nothing consumes it anymore.
            rm -f "$QS/dock/palettes/index.json"
            cp -f "$BASE/palettes"/*.json "$QS/dock/palettes/" 2>/dev/null || true ;;
        theme-sync)
            mkdir -p "$BIN"
            cat > "$BIN/theme-sync" <<WRAP
#!/usr/bin/env bash
# equisdots · theme-sync wrapper (engine lives in its own repo)
exec "$BASE/theme-sync/theme-sync.sh" "\$@"
WRAP
            chmod +x "$BIN/theme-sync"
            ok "theme-sync -> $BIN/theme-sync" ;;
        davincix)
            mkdir -p "$BIN"
            cat > "$BIN/davincix" <<WRAP
#!/usr/bin/env bash
# equisdots · davincix wrapper (kernel lives in its own repo)
exec "$BASE/davincix/davincix.sh" "\$@"
WRAP
            chmod +x "$BIN/davincix"
            ok "davincix -> $BIN/davincix" ;;
        dots)
            mkdir -p "$BIN"
            cat > "$BIN/dots" <<WRAP
#!/usr/bin/env bash
# equisdots · dots wrapper (meta installer lives in its own repo)
exec "$BASE/dots/dots" "\$@"
WRAP
            chmod +x "$BIN/dots"
            ok "dots -> $BIN/dots" ;;
        login)
            msg "login: SDDM theme (installed system-wide by 'dots system')" ;;
        timex)
            msg "timex: engine -> $BIN/timex + ui -> $QS/ui/timex"
            mkdir -p "$BIN" "$QS/ui/timex"
            cat > "$BIN/timex" <<WRAP
#!/usr/bin/env bash
# equisdots · timex wrapper (engine lives in its own repo)
exec "$BASE/timex/core/timex.sh" "\$@"
WRAP
            chmod +x "$BIN/timex"
            find "$BASE/timex" -name '*.sh' -exec chmod +x {} + 2>/dev/null || true
            rsync -a --delete --exclude '.git*' --exclude 'docs/' "$BASE/timex/ui/" "$QS/ui/timex/" ;;
    esac
}

cmd_install() {
    local c r n=0
    for c in git rsync; do
        if ! command -v "$c" >/dev/null 2>&1; then
            warn "dots install requires '$c' (run: dots system first)"
            return 1
        fi
    done
    for r in "${REPOS[@]}"; do fetch_repo "$r" || true; done
    # If this very script was just updated, restart with the new version so the
    # old code never keeps running against a rewritten file.
    if [[ -n "$SELF_HASH" && "$(self_hash)" != "$SELF_HASH" ]]; then
        msg "dots was updated; restarting with the new version"
        exec "$SELF_PATH" "${ORIG_ARGS[@]}"
    fi
    for r in "${REPOS[@]}"; do sync_repo "$r"; done
    for r in "${REPOS[@]}"; do [[ -d "$BASE/$r" ]] && n=$((n + 1)); done
    if [[ "$n" -eq 0 ]]; then
        warn "no repo could be cloned (network/git?); nothing was installed"
        return 1
    fi
    # Keep the version state (About / updater popup) aligned with the payload.
    if [[ -f "$BASE/hyprland/updates.json" ]] && command -v jq >/dev/null 2>&1; then
        local v
        v="$(jq -r '.version // empty' "$BASE/hyprland/updates.json" 2>/dev/null)"
        if [[ -n "$v" ]]; then
            mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}"
            printf 'LOCAL_VERSION="%s"\n' "$v" > "${XDG_STATE_HOME:-$HOME/.local/state}/equisdots-version"
        fi
    fi
    ok "installed ($n/${#REPOS[@]} repos) — restart the shell (qs kill; qs -p $QS/Shell.qml &)"
}

cmd_update() { cmd_install; }

# One-shot full install. Payload first (no sudo, always lands), system stack
# after. If git/rsync are missing the system stack runs first (it installs
# them) and the payload is retried afterwards. Failures are reported but never
# abort the other phase: a broken system step must not leave the desktop
# without the shell, palettes, engines or wrappers.
cmd_setup() {
    if command -v git >/dev/null 2>&1 && command -v rsync >/dev/null 2>&1; then
        cmd_install || warn "payload phase had errors (see above)"
        cmd_system "$@" || warn "system phase failed — payload is installed. Log: ls -t /tmp/hyprland-install-*.log | head -1; retry with: dots system"
    else
        warn "git/rsync missing: running the system stack first (installs them), then the payload"
        cmd_system "$@" || warn "system phase failed; trying the payload anyway"
        cmd_install || warn "payload phase had errors (see above)"
    fi
    ok "setup finished — log out and pick Hyprland at the login screen"
}

cmd_system() {
    msg "system stack: hyprland installer (packages, fonts, login theme, PAM, external configs)"
    fetch_repo hyprland || true
    if [[ ! -x "$BASE/hyprland/install.sh" ]]; then
        warn "hyprland/install.sh not found (clone failed?)"
        return 1
    fi
    # The guard tells install.sh that this run is under dots: the user payload
    # (shell, palettes, engines) is deployed by cmd_install right after.
    DOTS_SYSTEM_RUN=1 bash "$BASE/hyprland/install.sh" "$@"
}

cmd_list() {
    printf '%-12s %-10s %s\n' REPO STATE PATH
    for r in "${REPOS[@]}"; do
        local state="missing"
        [[ -d "$BASE/$r/.git" ]] && state=$(git -C "$BASE/$r" status --porcelain | wc -l | xargs -I{} sh -c '[[ {} -eq 0 ]] && echo clean || echo dirty')
        printf '%-12s %-10s %s\n' "$r" "$state" "$BASE/$r"
    done
}

cmd_doctor() {
    local fail=0
    # Required by autostart / keybinds / scripts.
    for c in git rsync hyprland qs jq curl python3 cava playerctl wl-paste cliphist \
             brightnessctl pamixer kitty rofi xwww-daemon mpvpaper; do
        if command -v "$c" >/dev/null 2>&1; then ok "$c"; else printf '\033[1;33m !\033[0m %s missing\n' "$c"; fail=1; fi
    done
    # Nice to have (their features degrade gracefully).
    for c in grim slurp satty hyprpicker blueman-applet nm-applet gsettings; do
        if command -v "$c" >/dev/null 2>&1; then ok "$c"; else printf '\033[1;33m ~\033[0m %s optional, missing\n' "$c"; fi
    done
    if fc-match "Hack Nerd Font" 2>/dev/null | grep -qi "Hack Nerd Font"; then ok "Hack Nerd Font"; else printf '\033[1;33m !\033[0m Hack Nerd Font missing (glyphs will show as boxes)\n'; fail=1; fi
    printf '\033[1;34m::\033[0m xwww (wallpaper daemon, fork with extra transitions): build with scripts/install-xwww.sh\n' 

    # Repo clones (dots install).
    local r
    for r in "${REPOS[@]}"; do
        if [[ -d "$BASE/$r/.git" ]]; then ok "$r clone"; else printf '\033[1;33m !\033[0m %s clone missing (run: dots install)\n' "$r"; fail=1; fi
    done

    # Installed payload (dots install).
    local np
    np="$(ls "$QS/dock/palettes"/*.json 2>/dev/null | wc -l)"
    if [[ "$np" -gt 0 ]]; then ok "palettes ($np in $QS/dock/palettes)"; else printf '\033[1;33m !\033[0m no palettes in %s (run: dots install)\n' "$QS/dock/palettes"; fail=1; fi
    for p in "$HYPR/hyprland.lua" "$QS/Shell.qml" "$QS/Lock.qml" "$QS/ui/timex/TimexPopup.qml" "$HYPR/settings.json" "$HYPR/scripts/lock.sh" "$HYPR/hypridle.conf" "$BIN/timex" "$BIN/davincix" "$BIN/theme-sync" "$BIN/dots"; do
        [[ -e "$p" ]] && ok "$p" || printf '\033[1;33m !\033[0m %s missing (run: dots install)\n' "$p"
    done

    # Version gates: the config is Lua (Hyprland 0.55+) and the wrappers live
    # in ~/.local/bin, which has to be reachable.
    if command -v hyprland >/dev/null 2>&1; then
        local hv
        hv="$(hyprland --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+' | head -1)"
        if [[ -n "$hv" ]] && awk -v v="$hv" 'BEGIN { exit !(v + 0 >= 0.55) }'; then
            ok "hyprland $hv (Lua config)"
        else
            printf '\033[1;33m !\033[0m hyprland < 0.55: config/hyprland.lua needs Lua support (update hyprland)\n'; fail=1
        fi
    fi
    case ":$PATH:" in
        *":$HOME/.local/bin:"*) ok "$HOME/.local/bin in PATH" ;;
        *) printf '\033[1;33m !\033[0m %s not in PATH (dots/timex/davincix/theme-sync unreachable; run: dots system)\n' "$HOME/.local/bin"; fail=1 ;;
    esac

    # System pieces: lock PAM service and the static login (SDDM) theme.
    if [[ -f /etc/pam.d/quickshell ]] && grep -q "system-auth" /etc/pam.d/quickshell 2>/dev/null; then
        ok "/etc/pam.d/quickshell (lock screen PAM)"
    else
        printf '\033[1;33m !\033[0m /etc/pam.d/quickshell missing system-auth (run: dots system)\n'; fail=1
    fi
    if [[ -f /etc/sddm.conf.d/10-x-theme.conf ]]; then ok "/etc/sddm.conf.d/10-x-theme.conf"; else printf '\033[1;33m !\033[0m /etc/sddm.conf.d/10-x-theme.conf missing (run: dots system)\n'; fail=1; fi
    if [[ -f /usr/share/sddm/themes/x/Main.qml && ! -e /usr/share/sddm/themes/x/Colors.qml ]]; then
        ok "login theme 'x' (static)"
    elif [[ -f /usr/share/sddm/themes/x/Main.qml ]]; then
        printf '\033[1;33m !\033[0m old palette-synced SDDM theme installed (run: dots system)\n'; fail=1
    else
        printf '\033[1;33m !\033[0m /usr/share/sddm/themes/x missing (run: dots system)\n'; fail=1
    fi

    # Monthly updater timer (dots install / install.sh).
    if systemctl --user is-active --quiet dotfiles-update.timer 2>/dev/null; then
        ok "dotfiles-update.timer active"
    else
        printf '\033[1;33m ~\033[0m dotfiles-update.timer not active (run: dots install)\n'
    fi
    local unit_exec
    unit_exec="$(systemctl --user show -p ExecStart --value dotfiles-update.service 2>/dev/null | grep -o '/[^ ;]*dotfiles-update\.sh' | head -1)"
    if [[ -n "$unit_exec" && "$unit_exec" != "$HYPR/scripts/dotfiles-update.sh" && "$unit_exec" != "$BASE/hyprland/scripts/dotfiles-update.sh" ]]; then
        printf '\033[1;33m ~\033[0m dotfiles-update.service points outside the install (%s); re-run: dots install\n' "$unit_exec"
    fi
    exit $fail
}

cmd_uninstall() {
    msg "removing links and the updater timer; config files and clones are kept"
    if [[ -x "$HYPR/scripts/dotfiles-update.sh" ]]; then
        bash "$HYPR/scripts/dotfiles-update.sh" --uninstall-timer >/dev/null 2>&1 || true
    else
        systemctl --user disable --now dotfiles-update.timer >/dev/null 2>&1 || true
        rm -f "$CFG/systemd/user/dotfiles-update.timer" "$CFG/systemd/user/dotfiles-update.service"
        systemctl --user daemon-reload >/dev/null 2>&1 || true
    fi
    rm -f "$BIN/theme-sync" "$BIN/davincix" "$BIN/timex" "$BIN/dots"
    ok "done (repos remain in $BASE)"
}

case "${1:-help}" in
    setup)     shift; cmd_setup "$@" ;;
    install)   cmd_install ;;
    update)    cmd_update ;;
    system)    shift; cmd_system "$@" ;;
    doctor)    cmd_doctor ;;
    list)      cmd_list ;;
    uninstall) cmd_uninstall ;;
    *) usage ;;
esac
